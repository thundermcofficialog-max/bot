DISCORD_TOKEN=MTUzNDgxODc5MjI5MzY2Njg2Ng.GfPmFt.5UfKp7t35wRzsnaxIIxmOtvPnBr9bHkJ6cU3R0
BOT_NAME=LuckyNodes
PREFIX=!
YOUR_SERVER_IP=51.162.178.199
MAIN_ADMIN_ID=1497884817524523092
DEFAULT_STORAGE_POOL=default

# notspidy settings
DEFAULT_PORT_LIMIT=4
MAX_SNAPSHOTS_PER_VPS=3
STATUS_ROTATE_SECONDS=15
DEFAULT_VPS_EXPIRATION_DAYS=30


# ═══ Invite rewards (!claim) ═══
# Claim rules
CLAIM_SPEND_INVITES=true          # true = invites are deducted on claim, false = only a threshold
CLAIM_MAX_VPS_PER_USER=0        # 0 = unlimited
CLAIM_MIN_ACCOUNT_AGE_DAYS=90      # invited accounts younger than this don't count (fake protection)
CLAIM_DEFAULT_OS=ubuntu:22.04
CLAIM_LOG_CHANNEL_ID=0            # channel ID for claim logs / fallback notifications (0 = off)
INVITE_CHANNEL_ID=0               # channel used to create !invitelink links (0 = rules/system/current channel)

# Notifications, roles, renew, reminders
CLAIM_NOTIFY_INVITES=true         # DM the inviter when someone joins/leaves
MILESTONES_ENABLED=true           # roles at 5 / 10 / 25 invites
RENEW_COST_PERCENT=50             # !renew costs this % of the plan's invites
CLAIM_REMIND_DAYS=3               # expiry reminder DM this many days before

# Host capacity (your server: 26GB RAM / 6 cores / 200GB disk)
HOST_RAM_GB=26
HOST_CPU_CORES=6
HOST_DISK_GB=200
# Overcommit multipliers (0 = no limit). 4.0 on 26GB RAM = up to 104GB allocated
RAM_OVERCOMMIT=20.0
CPU_OVERCOMMIT=60.0
DISK_OVERCOMMIT=60.0

# Safety rails (keep these even with overcommit)
CLAIM_MIN_FREE_RAM_MB=0      # pause claims if host free RAM drops below this (0 = off)
CLAIM_MAX_DISK_PCT=0             # pause claims if host disk is this % full (0 = off)
CLAIM_DISK_CHECK_PATH=/
